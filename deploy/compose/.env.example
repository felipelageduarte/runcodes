# ===========================================================================
# run.codes — configuração do deploy single-server (docker-compose.prod.yml)
# Copie para .env e preencha. Tudo que tem default razoável está comentado.
# ===========================================================================

# Domínio público da aplicação (Caddy emite TLS via Let's Encrypt).
# Sem domínio (teste local): use http://localhost
RC_APP_DOMAIN=app.exemplo.edu.br

# Diretório ABSOLUTO no host compartilhado entre o compiler e os containers
# de linguagem (workspaces de execução). Crie antes: mkdir -p /opt/runcodes/exec
RC_EXEC_DIR=/opt/runcodes/exec

# --- Segredos (gere valores fortes: `openssl rand -hex 32`) ----------------
RC_DB_PASSWORD=
RC_JWT_SECRET=
RC_SECURITY_SALT=
RC_S3_KEY=
RC_S3_SECRET=

# --- E-mail (SMTP real: Gmail/Workspace, SES, etc) --------------------------
RC_SMTP_HOST=smtp.gmail.com
RC_SMTP_PORT=465
RC_SMTP_SECURE=true
RC_SMTP_USER=
RC_SMTP_PASSWORD=
# RC_SMTP_FROM=run.codes <no-reply@exemplo.edu.br>

# --- Opcionais ---------------------------------------------------------------
# RC_TIMEZONE=America/Sao_Paulo
# RC_COMPILER_CONCURRENCY=8

# --- AWS / serviços gerenciados ---------------------------------------------
# Pra usar RDS/ElastiCache/S3 em vez dos containers locais, descomente e
# aponte pros endpoints gerenciados (e remova database/redis/seaweed do
# compose ou ignore-os). RC_S3_KEY/SECRET passam a ser credenciais IAM.
# RC_DATABASE_URL=postgresql://usuario:senha@xxx.rds.amazonaws.com:5432/runcodes
# RC_DB_HOST=xxx.rds.amazonaws.com
# RC_REDIS_URL=redis://xxx.cache.amazonaws.com:6379
# RC_S3_ENDPOINT=https://s3.sa-east-1.amazonaws.com
# RC_S3_REGION=sa-east-1
