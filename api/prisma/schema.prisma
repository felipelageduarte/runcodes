generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Run `npm run prisma:pull` against the real DB to replace this with the
// full introspected schema (28 tables — see database/schema/base.sql).
// Kept minimal here so the auth module has something to compile against.
model User {
  email        String    @id @db.VarChar(255)
  name         String    @db.VarChar(255)
  password     String    @db.VarChar(255) // legacy rows hold sha1 (40 chars); bcrypt rehash migrates in place on login
  type         Int
  creation     DateTime  @default(now())
  confirmed    Boolean?  @default(false)
  universityId Int?      @map("university_id")
  identifier   String?   @db.VarChar(50)
  source       Int?      @default(0)

  @@map("users")
}
